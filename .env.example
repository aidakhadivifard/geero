# Copy this file to `.env` and fill in your key.
# The key is read only by the Express server — it is never sent to the browser.

# Required for real card generation (https://console.anthropic.com/).
ANTHROPIC_API_KEY=

# Optional. Port the API/server listens on. Defaults to 8787.
PORT=8787

# Optional. When set to "1" and no API key is present, the server serves a small
# curated local card library so the UI stays navigable for demos. Off by default
# so you always know whether you're seeing real, personalized output.
DAWNHALO_ALLOW_FALLBACK=0
